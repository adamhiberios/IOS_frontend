{
  "name": "ios-lms",
  "version": "0.0.0",
  "description": "Institute of Scrum (IOS) Learning Management System — Angular 21 frontend.",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "20.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=development",
    "build": "ng build --configuration development",
    "build:dev": "ng build --configuration=development",
    "build:test": "ng build --configuration=test",
    "build:uat": "ng build --configuration=uat",
    "watch": "ng build --watch --configuration=development",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ng build --configuration=production --stats-json && npx --yes webpack-bundle-analyzer dist/ios-lms/stats.json",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "test": "echo \"Tests deferred per SOW §6.2.14 — see /docs/05 §8.\" && exit 0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@lucide/angular": "^1.11.0",
    "apexcharts": "^5.11.0",
    "ng-apexcharts": "^2.4.0",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.4",
    "angular-eslint": "^21.3.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.12",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.0"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix"
    ],
    "*.{ts,html,css,scss,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
